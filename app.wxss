/* 全局样式 */
page {
  background-color: #FFF9FA;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', SimSun, sans-serif;
  color: #333333;
}

.container {
  padding: 20rpx;
}

/* 颜色变量 */
:root {
  --primary-color: #FF6B9D;
  --primary-light: #FFB6C1;
  --primary-dark: #E85A8C;
  --secondary-color: #7BCFDE;
  --success-color: #5BB974;
  --warning-color: #F5A623;
  --danger-color: #E74C3C;
  --text-primary: #333333;
  --text-secondary: #666666;
  --text-light: #999999;
  --border-color: #E6E6E6;
  --bg-color: #FFF9FA;
  --card-bg: #FFFFFF;
}

/* 按钮样式 */
.btn-primary {
  background-color: var(--primary-color);
  color: #FFFFFF;
  border-radius: 50rpx;
}

.btn-secondary {
  background-color: var(--secondary-color);
  color: #FFFFFF;
  border-radius: 50rpx;
}

/* 卡片样式 */
.card {
  background: #FFFFFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(255, 107, 157, 0.1);
  margin-bottom: 20rpx;
  overflow: hidden;
}

.card-header {
  padding: 30rpx;
  border-bottom: 1rpx solid var(--border-color);
  font-weight: bold;
  color: var(--text-primary);
}

.card-body {
  padding: 30rpx;
}

/* 标签样式 */
.tag {
  display: inline-block;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  margin-right: 10rpx;
  margin-bottom: 10rpx;
}

.tag-primary {
  background-color: var(--primary-light);
  color: var(--primary-color);
}

.tag-success {
  background-color: rgba(91, 185, 116, 0.1);
  color: var(--success-color);
}

.tag-warning {
  background-color: rgba(245, 166, 35, 0.1);
  color: var(--warning-color);
}

/* 图标样式 */
.icon {
  width: 48rpx;
  height: 48rpx;
}

.icon-small {
  width: 32rpx;
  height: 32rpx;
}

/* 导航栏样式 */
.navbar {
  background: linear-gradient(135deg, var(--primary-color), var(--primary-light));
  color: #FFFFFF;
}

/* 列表项样式 */
.list-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid var(--border-color);
}

.list-item:last-child {
  border-bottom: none;
}

.list-item-icon {
  margin-right: 20rpx;
}

.list-item-content {
  flex: 1;
}

.list-item-arrow {
  color: var(--text-light);
}

/* 进度条样式 */
.progress {
  background-color: #F0F0F0;
  border-radius: 10rpx;
  height: 20rpx;
  overflow: hidden;
}

.progress-bar {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), var(--secondary-color));
  border-radius: 10rpx;
  transition: width 0.3s ease;
}

/* 动画效果 */
.fade-in {
  animation: fadeIn 0.5s ease-in;
}

@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.bounce {
  animation: bounce 0.6s ease;
}

@keyframes bounce {
  0%, 20%, 53%, 80%, 100% {
    transform: translate3d(0, 0, 0);
  }
  40%, 43% {
    transform: translate3d(0, -30rpx, 0);
  }
  70% {
    transform: translate3d(0, -15rpx, 0);
  }
  90% {
    transform: translate3d(0, -4rpx, 0);
  }
}

/* 响应式布局 */
@media (max-width: 750rpx) {
  .container {
    padding: 15rpx;
  }
  
  .card {
    border-radius: 15rpx;
    margin-bottom: 15rpx;
  }
  
  .card-header,
  .card-body {
    padding: 20rpx;
  }
}

/* 特殊样式 */
.baby-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 4rpx solid var(--primary-light);
  background: linear-gradient(135deg, var(--primary-color), var(--secondary-color));
  display: flex;
  align-items: center;
  justify-content: center;
  color: white;
  font-size: 48rpx;
  font-weight: bold;
}

.stats-item {
  text-align: center;
  padding: 20rpx;
}

.stats-number {
  font-size: 48rpx;
  font-weight: bold;
  color: var(--primary-color);
}

.stats-label {
  font-size: 24rpx;
  color: var(--text-secondary);
  margin-top: 10rpx;
}