/* ai.wxss - 重新设计UI */

/* 页面整体样式 */
.ai-page {
  background: linear-gradient(135deg, #f8f9ff 0%, #f0f2ff 100%);
  min-height: 100vh;
}

/* 其他食物小组件样式 */
.ingredient-item.custom-food {
  border: 2rpx dashed #ccc;
  background: #f8f9fa;
}

.ingredient-item.custom-food.selected {
  border-color: #667eea;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border-style: solid;
}

/* 自定义食物弹窗样式 */
.custom-food-popup {
  background: white;
  border-radius: 20rpx;
  width: 560rpx;
  padding: 0;
  overflow: hidden;
}

.popup-header {
  padding: 30rpx 30rpx 0;
  text-align: center;
}

.popup-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.popup-content {
  padding: 30rpx;
}

.popup-content .input-label {
  display: block;
  font-size: 28rpx;
  color: #333;
  margin-bottom: 20rpx;
  font-weight: 500;
}

.popup-actions {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx 30rpx;
}

.popup-actions t-button {
  flex: 1;
}

/* 重新设计导航栏 */
.tabs-container {
