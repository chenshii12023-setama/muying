.ai-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tab-content {
  padding: 20rpx;
}

/* AI聊天样式 */
.chat-container {
  height: calc(100vh - 200rpx);
  display: flex;
  flex-direction: column;
}

.messages-container {
  flex: 1;
  overflow-y: auto;
  margin-bottom: 20rpx;
}

.message {
  display: flex;
  margin-bottom: 30rpx;
  align-items: flex-start;
}

.message.user-message {
  flex-direction: row-reverse;
}

.message-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin: 0 20rpx;
}

.user-message .message-avatar {
  background: #1890ff;
  color: white;
}

.ai-message .message-avatar {
  background: #52c41a;
  color: white;
}

.message-content {
  flex: 1;
  max-width: 70%;
}

.message-text {
  display: block;
  padding: 20rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.user-message .message-text {
  background: #1890ff;
  color: white;
  border-top-right-radius: 4rpx;
}

.ai-message .message-text {
  background: white;
  color: #333;
  border-top-left-radius: 4rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.message-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
  text-align: right;
}

.input-container {
  background: white;
  padding: 20rpx;
  border-radius: 16rpx;
  box-shadow: 0 -2rpx 8rpx rgba(0,0,0,0.1);
}

.input-box {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.send-btn {
  flex-shrink: 0;
}

.quick-questions {
  margin-top: 20rpx;
}

.quick-title {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.quick-buttons {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

/* 营养计算器样式 */
.nutrition-calculator {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
}

.calculator-header {
  text-align: center;
  margin-bottom: 30rpx;
}

.calculator-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
}

.calculator-desc {
  display: block;
  font-size: 24rpx;
  color: #666;
}

.ingredients-section {
  margin: 30rpx 0;
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.ingredients-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.ingredient-item {
  text-align: center;
  padding: 20rpx;
  border: 2rpx solid #f0f0f0;
  border-radius: 12rpx;
  cursor: pointer;
  transition: all 0.3s;
}

.ingredient-item.selected {
  border-color: #1890ff;
  background: #f0f8ff;
}

.ingredient-icon {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.ingredient-name {
  font-size: 24rpx;
  color: #666;
}

.amount-section {
  margin: 30rpx 0;
}

.amount-item {
  margin-bottom: 30rpx;
}

.amount-control {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 12rpx;
}

.amount-value {
  font-size: 24rpx;
  color: #1890ff;
  font-weight: bold;
  min-width: 80rpx;
}

.result-section {
  margin: 30rpx 0;
  padding: 20rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
}

.nutrition-results {
  margin-bottom: 20rpx;
}

.nutrition-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #e8e8e8;
}

.nutrition-item:last-child {
  border-bottom: none;
}

.nutrient-name {
  font-size: 26rpx;
  color: #333;
}

.nutrient-value {
  font-size: 26rpx;
  font-weight: bold;
  color: #1890ff;
}

.recommendation {
  background: white;
  padding: 20rpx;
  border-radius: 8rpx;
  border-left: 4rpx solid #52c41a;
}

.rec-title {
  display: block;
  font-size: 24rpx;
  font-weight: bold;
  color: #52c41a;
  margin-bottom: 8rpx;
}

.rec-content {
  font-size: 24rpx;
  color: #666;
  line-height: 1.5;
}

.calculator-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}