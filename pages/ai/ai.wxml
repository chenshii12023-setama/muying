<view class="ai-page">
  <!-- 成长评估页面 -->
  <t-tabs value="{{activeTab}}" bind:change="onTabChange">
    <t-tab-panel label="成长评估" value="assessment">
      <view class="tab-content">
        <!-- 成长评估区域 -->
        <view class="assessment-container">
          
          <!-- 宝宝信息展示 -->
          <view class="baby-info-section" wx:if="{{babyInfo}}">
            <text class="section-title">当前宝宝信息</text>
            <view class="baby-info-card">
              <view class="baby-info-item">
                <text class="info-label">姓名：</text>
                <text class="info-value">{{babyInfo.name}}</text>
              </view>
              <view class="baby-info-item">
                <text class="info-label">性别：</text>
                <text class="info-value">{{babyInfo.gender === 'male' ? '男宝' : '女宝'}}</text>
              </view>
              <view class="baby-info-item">
                <text class="info-label">年龄：</text>
                <text class="info-value">{{growthData.age}}个月</text>
              </view>
              <view class="baby-info-item">
                <text class="info-label">身高：</text>
                <text class="info-value">{{growthData.height || 0}} cm</text>
              </view>
              <view class="baby-info-item">
                <text class="info-label">体重：</text>
                <text class="info-value">{{growthData.weight || 0}} kg</text>
              </view>
            </view>
          </view>
          
          <!-- 评估数据输入 -->
          <view class="input-section">
            <text class="section-title">成长评估数据</text>
            
            <view class="input-group">
              <view class="input-row">
                <text class="input-label">宝宝年龄（月）</text>
                <t-input 
                  type="number"
                  placeholder="请输入宝宝年龄"
                  value="{{growthData.age}}"
                  bind:change="onGrowthDataChange"
                  data-field="age"
                />
              </view>
              
              <view class="input-row">
                <text class="input-label">宝宝性别</text>
                <view class="gender-selector">
                  <t-radio-group value="{{growthData.gender}}" bind:change="onGrowthDataChange" data-field="gender">
                    <t-radio value="boy">男宝</t-radio>
                    <t-radio value="girl">女宝</t-radio>
                  </t-radio-group>
                </view>
              </view>
              
              <view class="input-row">
                <text class="input-label">身高（cm）</text>
                <t-input 
                  type="digit"
                  placeholder="请输入身高"
                  value="{{growthData.height}}"
                  bind:change="onGrowthDataChange"
                  data-field="height"
                />
              </view>
              
              <view class="input-row">
                <text class="input-label">体重（kg）</text>
                <t-input 
                  type="digit"
                  placeholder="请输入体重"
                  value="{{growthData.weight}}"
                  bind:change="onGrowthDataChange"
                  data-field="weight"
                />
              </view>
            </view>
            
            <view class="assessment-actions">
              <t-button 
                theme="primary" 
                bind:tap="startGrowthAssessment"
                loading="{{isAssessing}}"
                disabled="{{isAssessing}}"
              >
                {{isAssessing ? '评估中...' : '开始成长评估'}}
              </t-button>
            </view>
          </view>
          
          <!-- 评估结果显示 -->
          <view class="result-section" wx:if="{{assessmentResult}}">
            <text class="section-title">成长评估结果</text>
            
            <view class="result-card">
              <view class="result-header">
                <text class="result-title">发育分析</text>
                <text class="result-time">{{assessmentResult.timestamp}}</text>
              </view>
              
              <view class="analysis-content">
                <text class="analysis-text">{{assessmentResult.analysis}}</text>
              </view>
              
              <view class="advice-section">
                <text class="advice-title">专业建议</text>
                <text class="advice-text">{{assessmentResult.advice}}</text>
              </view>
              
              <view class="result-footer" wx:if="{{assessmentResult.isLocal}}">
                <text class="local-tag">本地评估</text>
              </view>
            </view>
            
            <view class="reassess-actions">
              <t-button size="small" bind:tap="reassess">重新评估</t-button>
            </view>
          </view>
          
          <!-- 无宝宝信息提示 -->
          <view class="no-baby-tip" wx:if="{{!babyInfo}}">
            <text class="tip-text">请先添加宝宝信息，系统将自动填充成长数据</text>
            <t-button theme="primary" bind:tap="goToAddBaby">去添加宝宝</t-button>
          </view>
          
        </view>
      </view>
    </t-tab-panel>
    
    <t-tab-panel label="营养计算" value="nutrition">
      <view class="tab-content">
        <view class="nutrition-calculator">
          <view class="calculator-header">
            <text class="calculator-title">婴幼儿辅食营养计算器</text>
            <text class="calculator-desc">根据宝宝年龄和食材计算营养摄入</text>
          </view>
          
          <view class="baby-info-section">
            <text class="section-title">宝宝信息</text>
            <view class="input-group">
              <view class="input-row">
                <text class="input-label">宝宝年龄（月）</text>
                <t-input 
                  type="number"
                  placeholder="请输入宝宝年龄"
                  value="{{babyAge}}"
                  bind:change="onMilkDataChange"
                  data-field="age"
                />
              </view>
              
              <view class="input-row">
                <text class="input-label">宝宝体重（kg）</text>
                <t-input 
                  type="digit"
                  placeholder="请输入体重"
                  value="{{babyWeight}}"
                  bind:change="onMilkDataChange"
                  data-field="weight"
                />
              </view>
            </view>
          </view>
          
          <view class="ingredients-section">
            <text class="section-title">选择食材</text>
            <view class="ingredients-grid">
              <view 
                wx:for="{{ingredients}}" 
                wx:key="id" 
                class="ingredient-item {{item.selected ? 'selected' : ''}}"
                bind:tap="toggleIngredient"
                data-id="{{item.id}}"
              >
                <view class="ingredient-icon">{{item.icon}}</view>
                <text class="ingredient-name">{{item.name}}</text>
              </view>
            </view>
          </view>
          
          <view class="amount-section" wx:if="{{selectedIngredients.length > 0}}">
            <text class="section-title">食材用量</text>
            <view wx:for="{{selectedIngredients}}" wx:key="id" class="amount-item">
              <text class="ingredient-name">{{item.name}}</text>
              <view class="amount-control">
                <t-slider 
                  value="{{item.amount}}" 
                  min="10" 
                  max="200" 
                  step="10"
                  bind:change="onAmountChange"
                  data-id="{{item.id}}"
                />
                <text class="amount-value">{{item.amount}}g</text>
              </view>
            </view>
          </view>
          
          <view class="result-section" wx:if="{{nutritionResult}}">
            <text class="section-title">营养分析结果</text>
            <view class="nutrition-results">
              <view class="nutrition-item">
                <text class="nutrient-name">热量</text>
                <text class="nutrient-value">{{nutritionResult.calories}} kcal</text>
              </view>
              <view class="nutrition-item">
                <text class="nutrient-name">蛋白质</text>
                <text class="nutrient-value">{{nutritionResult.protein}}g</text>
              </view>
              <view class="nutrition-item">
                <text class="nutrient-name">碳水化合物</text>
                <text class="nutrient-value">{{nutritionResult.carbs}}g</text>
              </view>
              <view class="nutrition-item">
                <text class="nutrient-name">脂肪</text>
                <text class="nutrient-value">{{nutritionResult.fat}}g</text>
              </view>
            </view>
            
            <view class="recommendation">
              <text class="rec-title">营养建议</text>
              <text class="rec-content">{{nutritionResult.recommendation}}</text>
            </view>
          </view>
          
          <view class="calculator-actions">
            <t-button theme="primary" bind:tap="calculateNutrition">计算营养</t-button>
            <t-button bind:tap="resetCalculator">重置</t-button>
          </view>
        </view>
      </view>
    </t-tab-panel>
    
    <t-tab-panel label="奶量计算" value="milk">
      <view class="tab-content">
        <view class="milk-calculator">
          <view class="calculator-header">
            <text class="calculator-title">婴幼儿奶量计算器</text>
            <text class="calculator-desc">根据宝宝年龄和体重计算每日奶量需求</text>
          </view>
          
          <view class="baby-info-section">
            <text class="section-title">宝宝信息</text>
            <view class="input-group">
              <view class="input-row">
                <text class="input-label">宝宝年龄（月）</text>
                <t-input 
                  type="number"
                  placeholder="请输入宝宝年龄"
                  value="{{babyAge}}"
                  bind:change="onMilkDataChange"
                  data-field="age"
                />
              </view>
              
              <view class="input-row">
                <text class="input-label">宝宝体重（kg）</text>
                <t-input 
                  type="digit"
                  placeholder="请输入体重"
                  value="{{babyWeight}}"
                  bind:change="onMilkDataChange"
                  data-field="weight"
                />
              </view>
            </view>
          </view>
          
          <view class="milk-type-section">
            <text class="section-title">喂养方式</text>
            <view class="type-selector">
              <t-radio-group value="{{milkType}}" bind:change="onMilkTypeChange">
                <t-radio value="formula">配方奶</t-radio>
                <t-radio value="breast">母乳</t-radio>
              </t-radio-group>
            </view>
          </view>
          
          <view class="calculate-section">
            <t-button 
              theme="primary" 
              bind:tap="calculateMilk"
              loading="{{isCalculatingMilk}}"
              disabled="{{isCalculatingMilk}}"
            >
              {{isCalculatingMilk ? '计算中...' : '计算奶量'}}
            </t-button>
          </view>
          
          <view class="result-section" wx:if="{{milkResult}}">
            <text class="section-title">奶量计算结果</text>
            
            <view class="milk-result-card">
              <view class="result-header">
                <text class="result-title">推荐奶量</text>
                <text class="result-time">{{milkResult.timestamp}}</text>
              </view>
              
              <view class="milk-data">
                <view class="milk-item">
                  <text class="milk-label">每日总量：</text>
                  <text class="milk-value">{{milkResult.total_range}} {{milkResult.unit}}</text>
                </view>
                <view class="milk-item">
                  <text class="milk-label">单次奶量：</text>
                  <text class="milk-value">{{milkResult.per_feed}} {{milkResult.unit}}</text>
                </view>
                <view class="milk-item">
                  <text class="milk-label">喂养次数：</text>
                  <text class="milk-value">{{milkResult.calc_detail.frequency}}次/天</text>
                </view>
                <view class="milk-item">
                  <text class="milk-label">喂养方式：</text>
                  <text class="milk-value">{{milkResult.calc_detail.type === 'formula' ? '配方奶' : '母乳'}}</text>
                </view>
              </view>
              
              <view class="advice-section">
                <text class="advice-title">喂养建议</text>
                <text class="advice-text">{{milkResult.advice}}</text>
              </view>
              
              <view class="ai-comment-section">
                <text class="ai-comment-title">AI暖心提示</text>
                <text class="ai-comment-text">{{milkResult.ai_comment}}</text>
              </view>
              
              <view class="result-footer" wx:if="{{milkResult.isLocal}}">
                <text class="local-tag">本地计算</text>
              </view>
            </view>
            
            <view class="recalculate-actions">
              <t-button size="small" bind:tap="recalculateMilk">重新计算</t-button>
            </view>
          </view>
          
          <!-- 无宝宝信息提示 -->
          <view class="no-baby-tip" wx:if="{{!babyInfo}}">
            <text class="tip-text">请先添加宝宝信息，系统将自动填充成长数据</text>
            <t-button theme="primary" bind:tap="goToAddBaby">去添加宝宝</t-button>
          </view>
        </view>
      </view>
    </t-tab-panel>
  </t-tabs>
</view>