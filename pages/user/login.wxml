<view class="login-container">
  <!-- 用户信息展示 -->
  <view class="user-section" wx:if="{{isLoggedIn}}">
    <view class="user-avatar">
      <image src="{{userAvatar}}" mode="aspectFill"></image>
    </view>
    <view class="user-info">
      <text class="user-name">{{userName}}</text>
      <text class="user-status">已登录</text>
    </view>
    <view class="user-actions">
      <button class="action-btn" bindtap="editProfile">编辑资料</button>
      <button class="action-btn logout" bindtap="logout">退出登录</button>
    </view>
  </view>

  <!-- 登录界面 -->
  <view class="login-section" wx:else>
    <view class="login-header">
      <image class="login-icon" src="/images/default-avatar.png" mode="aspectFit"></image>
      <text class="login-title">登录/注册</text>
      <text class="login-desc">登录后可以发布商品和管理收藏</text>
    </view>
    
    <view class="login-actions">
      <button class="login-btn" bindtap="login">快速登录</button>
      <text class="login-tip">点击快速登录即可开始使用</text>
    </view>
  </view>

  <!-- 功能说明 -->
  <view class="features">
    <view class="feature-item">
      <text class="feature-icon">📱</text>
      <text class="feature-text">发布闲置商品</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">💖</text>
      <text class="feature-text">收藏心仪商品</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">💬</text>
      <text class="feature-text">与卖家沟通</text>
    </view>
    <view class="feature-item">
      <text class="feature-icon">🔒</text>
      <text class="feature-text">安全交易保障</text>
    </view>
  </view>
</view>