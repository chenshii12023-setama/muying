.market-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.market-header {
  background: white;
  padding: 20rpx 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.search-bar {
  margin-bottom: 20rpx;
}

.filter-options {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.filter-scroll {
  flex: 1;
  white-space: nowrap;
}

.filter-tags {
  display: flex;
  gap: 16rpx;
}

.category-tag {
  background: #f5f5f5;
  color: #666;
  border: none;
}

.category-tag.active {
  background: #1890ff;
  color: white;
}

.sort-btn {
  display: flex;
  align-items: center;
  padding: 12rpx 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #666;
  gap: 8rpx;
}

.sort-icon {
  font-size: 20rpx;
}

.tab-content {
  padding: 20rpx;
}

.products-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.product-card {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.product-image {
  position: relative;
  height: 240rpx;
}

.product-img {
  width: 100%;
  height: 100%;
  background: #f0f0f0;
}

.product-tags {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.cert-tag {
  background: #52c41a !important;
  color: white !important;
}

.local-tag {
  background: #1890ff !important;
  color: white !important;
}

.product-info {
  padding: 20rpx;
}

.product-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 8rpx;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.product-price {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #f56c6c;
  margin-bottom: 4rpx;
}

.product-original-price {
  display: block;
  font-size: 22rpx;
  color: #999;
  text-decoration: line-through;
  margin-bottom: 12rpx;
}

.product-meta {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.seller-info {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.seller-name {
  font-size: 24rpx;
  color: #666;
}

.distance {
  font-size: 22rpx;
  color: #999;
}

.product-stats {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.rating-count {
  font-size: 20rpx;
  color: #999;
}

.my-products {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.my-product-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.product-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.product-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.product-details {
  flex: 1;
}

.product-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.product-status.selling {
  background: #f6ffed;
  color: #52c41a;
}

.product-status.sold {
  background: #f5f5f5;
  color: #999;
}

.product-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.product-stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 8rpx;
}

.stat-item {
  text-align: center;
}

.stat-label {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-bottom: 4rpx;
}

.stat-value {
  display: block;
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

.product-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.wishlist {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.wishlist-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.wishlist-header {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.wishlist-thumb {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  background: #f0f0f0;
}

.added-time {
  display: block;
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.wishlist-actions {
  display: flex;
  gap: 16rpx;
  justify-content: flex-end;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
  background: white;
  border-radius: 16rpx;
}

.empty-icon {
  display: block;
  font-size: 60rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-desc {
  display: block;
  font-size: 24rpx;
  color: #ccc;
  margin-bottom: 30rpx;
}

.publish-fab {
  position: fixed;
  bottom: 40rpx;
  left: 50%;
  transform: translateX(-50%);
}

.fab-btn {
  padding: 24rpx 32rpx;
  border-radius: 50rpx;
  box-shadow: 0 8rpx 24rpx rgba(24, 144, 255, 0.3);
}

.fab-icon {
  margin-right: 12rpx;
  font-size: 32rpx;
}

.fab-text {
  font-size: 28rpx;
}