.product-detail-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: white;
}

.product-swiper {
  height: 600rpx;
  background: white;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #f56c6c;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.cert-tag {
  display: inline-block;
  background: #52c41a;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
}

.local-tag {
  display: inline-block;
  background: #1890ff;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 12rpx;
  margin-left: 16rpx;
}

.product-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.detail-section {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1890ff;
}

.description-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
}

.trade-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  min-width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.distance {
  font-size: 24rpx;
  color: #1890ff;
}

.seller-info {
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
}

.seller-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.seller-details {
  flex: 1;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.seller-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.verified-tag {
  display: inline-block;
  background: #52c41a;
  color: white;
  font-size: 18rpx;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
}

.seller-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.star-rating {
  display: flex;
  align-items: center;
  gap: 8rpx;
}

.stars {
  color: #f39c12;
  font-size: 24rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #f56c6c;
  font-weight: bold;
}

.review-count {
  font-size: 22rpx;
  color: #999;
}

.seller-avatar {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f0f0f0;
}

.seller-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.action-left {
  display: flex;
  gap: 30rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 60rpx;
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-icon.liked {
  animation: heartbeat 0.3s ease-in-out;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.action-right {
  display: flex;
  gap: 20rpx;
  flex: 1;
  max-width: 400rpx;
}

.contact-form {
  padding: 20rpx 0;
}

.contact-tips {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f6ffed;
  border-radius: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #52c41a;
  line-height: 1.4;
}

/* 联系卖家弹窗样式 */
.contact-modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.contact-modal {
  background: white;
  border-radius: 16rpx;
  width: 600rpx;
  max-height: 80vh;
  overflow: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-close {
  font-size: 36rpx;
  color: #999;
  width: 60rpx;
  height: 60rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.modal-content {
  padding: 30rpx;
}

.message-input {
  width: 100%;
  min-height: 200rpx;
  padding: 20rpx;
  border: 1rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  line-height: 1.5;
  background: #f8f9fa;
}

.modal-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.cancel-btn, .confirm-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  border: none;
  border-radius: 0;
}

.cancel-btn {
  background: white;
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.confirm-btn {
  background: #1890ff;
  color: white;
}

.cancel-btn:active {
  background: #f5f5f5;
}

.confirm-btn:active {
  background: #1677ff;
}

@keyframes heartbeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}