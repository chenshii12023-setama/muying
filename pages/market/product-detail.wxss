.product-detail-page {
  background-color: #f5f5f5;
  min-height: 100vh;
  padding-bottom: 120rpx;
}

.loading-container {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 100vh;
  background: white;
}

.product-swiper {
  height: 600rpx;
  background: white;
}

.product-image {
  width: 100%;
  height: 100%;
}

.product-info {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.price-section {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.current-price {
  font-size: 48rpx;
  font-weight: bold;
  color: #f56c6c;
}

.original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-through;
}

.cert-tag {
  background: #52c41a !important;
  color: white !important;
  border: none !important;
}

.local-tag {
  background: #1890ff !important;
  color: white !important;
  border: none !important;
}

.product-title {
  display: block;
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.product-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #666;
  background: #f5f5f5;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
}

.detail-section {
  background: white;
  padding: 30rpx;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  border-left: 8rpx solid #1890ff;
}

.description-text {
  font-size: 28rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
}

.trade-info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.info-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.info-label {
  font-size: 26rpx;
  color: #666;
  min-width: 160rpx;
}

.info-value {
  font-size: 26rpx;
  color: #333;
  flex: 1;
}

.distance {
  font-size: 24rpx;
  color: #1890ff;
}

.seller-info {
  background: #f8f9fa;
  padding: 24rpx;
  border-radius: 12rpx;
}

.seller-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 16rpx;
}

.seller-details {
  flex: 1;
}

.seller-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 8rpx;
}

.seller-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.seller-stats {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.rating-text {
  font-size: 24rpx;
  color: #f56c6c;
  font-weight: bold;
}

.review-count {
  font-size: 22rpx;
  color: #999;
}

.seller-meta {
  display: flex;
  gap: 20rpx;
  flex-wrap: wrap;
}

.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  padding: 20rpx 30rpx;
  border-top: 1rpx solid #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  box-shadow: 0 -2rpx 10rpx rgba(0,0,0,0.1);
}

.action-left {
  display: flex;
  gap: 30rpx;
}

.action-btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  min-width: 60rpx;
}

.action-icon {
  font-size: 32rpx;
  line-height: 1;
}

.action-icon.liked {
  animation: heartbeat 0.3s ease-in-out;
}

.action-text {
  font-size: 22rpx;
  color: #666;
}

.action-right {
  display: flex;
  gap: 20rpx;
  flex: 1;
  max-width: 400rpx;
}

.contact-form {
  padding: 20rpx 0;
}

.contact-tips {
  margin-top: 16rpx;
  padding: 16rpx;
  background: #f6ffed;
  border-radius: 8rpx;
}

.tips-text {
  font-size: 24rpx;
  color: #52c41a;
  line-height: 1.4;
}

@keyframes heartbeat {
  0% { transform: scale(1); }
  50% { transform: scale(1.2); }
  100% { transform: scale(1); }
}