<!--pages/index/index.wxml-->
<view class="index-page">
  <!-- 顶部欢迎卡片 -->
  <view class="welcome-section">
    <view class="welcome-card">
      <view class="baby-avatar">{{babyInfo.avatarText || '👶'}}</view>
      <view class="welcome-text">
        <text class="greeting">你好，{{userInfo.nickName || '宝妈'}}</text>
        <text class="baby-info">
          <text wx:if="{{babyInfo.age > 0}}">{{babyInfo.name}} {{babyInfo.age}}个月啦</text>
          <text wx:else>请先添加宝宝信息</text>
        </text>
      </view>
    </view>
  </view>

  <!-- 核心功能入口 -->
  <view class="function-grid">
    <view class="func-item primary" bindtap="navigate" data-url="/pages/ai/ai">
      <text class="icon">📊</text>
      <text>成长评估</text>
    </view>
    <view class="func-item secondary" bindtap="navigate" data-url="/pages/ai/ai?tab=nutrition">
      <text class="icon">🍎</text>
      <text>营养计算</text>
    </view>
  </view>

  <!-- 育儿知识核心区域 -->
  <view class="knowledge-section">
    <!-- 头部标题 + 选择器 -->
    <view class="section-header">
      <view class="header-left">
        <text class="title">育儿重点</text>
        <!-- 月份选择器 -->
        <picker mode="selector" range="{{monthRange}}" value="{{monthIndex}}" bindchange="onMonthChange">
          <view class="picker-wrap">
            <text class="picker-text">({{monthRange[monthIndex]}})</text>
            <text class="picker-arrow">▼</text>
          </view>
        </picker>
      </view>
    </view>
    
    <!-- 内容区域 -->
    <view class="knowledge-content" wx:if="{{currentMonthKnowledge}}">
      
      <!-- 1. 能力发展 -->
      <view class="k-category" wx:if="{{currentMonthKnowledge.skills.length > 0}}">
        <view class="cat-label skills">能力发展</view>
        <view class="cat-list">
          <view wx:for="{{currentMonthKnowledge.skills}}" wx:key="index" 
                class="k-item {{item.selected ? 'active' : ''}}"
                bindtap="toggleKnowledgeItem" data-category="skills" data-index="{{index}}">
            <text>{{item.text}}</text>
            <view class="check-icon"></view>
          </view>
        </view>
      </view>

      <!-- 2. 营养指导 -->
      <view class="k-category" wx:if="{{currentMonthKnowledge.nutrition.length > 0}}">
        <view class="cat-label nutrition">营养指导</view>
        <view class="cat-list">
          <view wx:for="{{currentMonthKnowledge.nutrition}}" wx:key="index"
                class="k-item {{item.selected ? 'active' : ''}}"
                bindtap="toggleKnowledgeItem" data-category="nutrition" data-index="{{index}}">
            <text>{{item.text}}</text>
            <view class="check-icon"></view>
          </view>
        </view>
      </view>

      <!-- 3. 睡眠建议 -->
      <view class="k-category" wx:if="{{currentMonthKnowledge.sleep.length > 0}}">
        <view class="cat-label sleep">睡眠建议</view>
        <view class="cat-list">
          <view wx:for="{{currentMonthKnowledge.sleep}}" wx:key="index"
                class="k-item {{item.selected ? 'active' : ''}}"
                bindtap="toggleKnowledgeItem" data-category="sleep" data-index="{{index}}">
            <text>{{item.text}}</text>
            <view class="check-icon"></view>
          </view>
        </view>
      </view>

      <!-- 4. 健康预警 -->
      <view class="k-category" wx:if="{{currentMonthKnowledge.warning.length > 0}}">
        <view class="cat-label warning">健康预警</view>
        <view class="cat-list">
          <view wx:for="{{currentMonthKnowledge.warning}}" wx:key="index"
                class="k-item warning-item {{item.selected ? 'active' : ''}}"
                bindtap="toggleKnowledgeItem" data-category="warning" data-index="{{index}}">
            <text>{{item.text}}</text>
            <view class="check-icon"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 加载中或空状态 -->
    <view class="empty-state" wx:else>
      <text wx:if="{{isLoading}}">正在加载育儿知识...</text>
      <text wx:else>暂无该月龄数据</text>
    </view>

    <!-- 底部保存条 -->
    <view class="action-bar safe-area-bottom" wx:if="{{selectedItems.length > 0}}">
      <view class="count">已选 {{selectedItems.length}} 项重点</view>
      <button class="save-btn" bindtap="saveSelectedItems">存入计划</button>
    </view>
  </view>
</view>