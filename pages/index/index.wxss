/* pages/index/index.wxss */
page {
  background-color: #F7F8FA;
  padding-bottom: 120rpx;
}

/* 欢迎区 */
.welcome-section {
  background: #FF6B9D;
  padding: 20rpx 30rpx 60rpx;
  border-radius: 0 0 40rpx 40rpx;
}
.welcome-card {
  background: rgba(255,255,255,0.95);
  padding: 24rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
}
.baby-avatar {
  width: 100rpx;
  height: 100rpx;
  background: #EAF4FE;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 24rpx;
}
.greeting { font-size: 32rpx; font-weight: bold; display: block; }
.baby-info { font-size: 26rpx; color: #666; margin-top: 6rpx; display: block; }

/* 功能按钮 */
.function-grid {
  display: flex;
  gap: 20rpx;
  padding: 0 30rpx;
  margin-top: -30rpx;
}
.func-item {
  flex: 1;
  background: #fff;
  height: 140rpx;
  border-radius: 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.func-item .icon { font-size: 48rpx; margin-bottom: 10rpx; }
.func-item text { font-size: 26rpx; color: #333; font-weight: 500; }

/* 知识区域 */
.knowledge-section {
  padding: 40rpx 30rpx;
}

/* 头部样式（含Picker） */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.header-left {
  display: flex;
  align-items: center;
}
.title {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
  margin-right: 12rpx;
}
.more { font-size: 26rpx; color: #999; }

/* 选择器胶囊样式 */
.picker-wrap {
  display: flex;
  align-items: center;
  background-color: #FFF0F5;
  padding: 6rpx 16rpx;
  border-radius: 30rpx;
  border: 1px solid #FFB6C1;
}
.picker-text {
  font-size: 26rpx;
  color: #FF6B9D;
  font-weight: bold;
}
.picker-arrow {
  font-size: 20rpx;
  color: #FF6B9D;
  margin-left: 8rpx;
  margin-top: 2rpx;
}

/* 分类卡片 */
.k-category {
  background: #fff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.cat-label {
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
  padding-left: 16rpx;
  position: relative;
}
.cat-label::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 4rpx;
}
.cat-label.skills::before { background: #5D9CEC; }
.cat-label.nutrition::before { background: #FFCE54; }
.cat-label.sleep::before { background: #A0D468; }
.cat-label.warning { color: #FF5500; }
.cat-label.warning::before { background: #FF5500; }

/* 条目样式 */
.k-item {
  display: flex;
  align-items: flex-start;
  padding: 16rpx;
  background: #F9F9F9;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}
.k-item:last-child { margin-bottom: 0; }
.k-item text {
  flex: 1;
  font-size: 28rpx;
  color: #444;
  line-height: 1.5;
}
.check-icon {
  width: 36rpx;
  height: 36rpx;
  border: 2rpx solid #ddd;
  border-radius: 50%;
  margin-left: 20rpx;
  flex-shrink: 0;
}

/* 选中态 */
.k-item.active {
  background: #FFF5F7;
  border-color: #FF6B9D;
}
.k-item.active .check-icon {
  background: #FF6B9D;
  border-color: #FF6B9D;
  position: relative;
}
.k-item.active .check-icon::after {
  content: '✓';
  color: #fff;
  position: absolute;
  left: 8rpx;
  top: -2rpx;
  font-size: 24rpx;
}

/* 底部浮动栏 */
.action-bar {
  position: fixed;
  bottom: 40rpx;
  left: 30rpx;
  right: 30rpx;
  background: #333;
  color: #fff;
  height: 100rpx;
  border-radius: 50rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 10rpx 0 40rpx;
  box-shadow: 0 10rpx 30rpx rgba(0,0,0,0.2);
}
.save-btn {
  background: #FF6B9D;
  color: #fff;
  border-radius: 40rpx;
  font-size: 28rpx;
  margin: 0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  color: #999;
  font-size: 28rpx;
  margin-top: 100rpx;
}