.baby-page {
  background-color: #f5f5f5;
  min-height: 100vh;
}

.baby-header {
  background: linear-gradient(135deg, #ff9a9e 0%, #fecfef 100%);
  padding: 30rpx 40rpx;
  color: white;
}

.baby-info {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.baby-avatar {
  width: 120rpx;
  height: 120rpx;
  background: rgba(255,255,255,0.2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  margin-right: 20rpx;
}

.baby-details {
  flex: 1;
}

.baby-name {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.baby-age {
  font-size: 28rpx;
  opacity: 0.9;
}

.baby-stats {
  display: flex;
  justify-content: space-around;
}

.stat-item {
  text-align: center;
}

.stat-value {
  display: block;
  font-size: 40rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  opacity: 0.9;
}

.tab-content {
  padding: 20rpx;
}

.action-buttons {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0;
}

.records-list {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.record-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.record-item:last-child {
  border-bottom: none;
}

.record-date {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 16rpx;
}

.record-data {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.record-data text {
  font-size: 32rpx;
  color: #333;
}

.record-actions {
  display: flex;
  justify-content: flex-end;
  gap: 20rpx;
}

.action-btn {
  color: #1890ff;
  font-size: 26rpx;
  padding: 8rpx 16rpx;
}

.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-text {
  display: block;
  font-size: 28rpx;
  color: #999;
  margin-bottom: 30rpx;
}

.milestones-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.milestone-card {
  background: white;
  padding: 30rpx;
  border-radius: 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.1);
}

.milestone-icon {
  font-size: 48rpx;
  margin-bottom: 16rpx;
}

.milestone-title {
  display: block;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.milestone-date {
  display: block;
  font-size: 24rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.milestone-status {
  font-size: 22rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.milestone-status.achieved {
  background: #f6ffed;
  color: #52c41a;
}

.milestone-status.pending {
  background: #fff7e6;
  color: #fa8c16;
}

.add-milestone-btn {
  margin-top: 40rpx;
  text-align: center;
}

.health-records {
  background: white;
  border-radius: 16rpx;
  overflow: hidden;
}

.health-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.health-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.health-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

.health-date {
  font-size: 24rpx;
  color: #666;
}

.health-details {
  font-size: 26rpx;
  color: #666;
  margin-bottom: 16rpx;
}