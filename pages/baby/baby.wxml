<view class="baby-page">
  <!-- ============================================================ -->
  <!-- 1. 添加宝宝表单 (当 showAddForm 为 true 时显示) -->
  <!-- ============================================================ -->
  <view wx:if="{{showAddForm}}" class="add-baby-container">
    <view class="add-baby-header">
      <view class="add-baby-avatar">👶</view>
      <view class="add-baby-title">添加宝宝信息</view>
      <view class="add-baby-subtitle">请填写宝宝的基本信息</view>
    </view>
    
    <view class="add-baby-form">
      <t-cell-group title="基本信息">
        <!-- 1. 姓名 -->
        <t-cell title="姓名" required>
          <input 
            slot="note"
            class="baby-input" 
            placeholder="请输入宝宝姓名" 
            value="{{name}}" 
            bindinput="onNameInput"
            style="text-align: right;"
          />
        </t-cell>
        
        <!-- 2. 性别 (🔥🔥🔥 终极修复：使用原生按钮，绝对能点 🔥🔥🔥) -->
        <view class="custom-cell" style="background: #fff; padding: 24rpx 32rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f0f0f0;">
          <view style="font-size: 32rpx; color: rgba(0, 0, 0, 0.9);">
            性别 <text style="color: #e34d59">*</text>
          </view>
          
          <view style="display: flex;">
            <!-- 男宝按钮 -->
            <view 
              bindtap="onGenderSelect" 
              data-value="male"
              style="padding: 12rpx 36rpx; border-radius: 8rpx; margin-right: 24rpx; font-size: 28rpx; transition: all 0.2s; border: 1px solid {{gender === 'male' ? '#0052d9' : '#dcdcdc'}}; color: {{gender === 'male' ? '#0052d9' : '#666'}}; background: {{gender === 'male' ? '#ecf2fe' : '#f5f5f5'}};"
            >
              男宝 👦
            </view>
            
            <!-- 女宝按钮 -->
            <view 
              bindtap="onGenderSelect" 
              data-value="female"
              style="padding: 12rpx 36rpx; border-radius: 8rpx; font-size: 28rpx; transition: all 0.2s; border: 1px solid {{gender === 'female' ? '#ff0080' : '#dcdcdc'}}; color: {{gender === 'female' ? '#ff0080' : '#666'}}; background: {{gender === 'female' ? '#fff0f6' : '#f5f5f5'}};"
            >
              女宝 👧
            </view>
          </view>
        </view>
        
        <!-- 3. 出生日期 (Picker 包裹 Cell) -->
        <picker 
          mode="date" 
          value="{{birthDate}}" 
          bindchange="onDateChange"
          start="2010-01-01"
          end="2030-12-31"
        >
          <t-cell 
            title="出生日期" 
            required 
            arrow 
            note="{{birthDate || '请选择'}}" 
          />
        </picker>
        
        <!-- 4. 血型 (Picker 包裹 Cell) -->
        <picker 
          mode="selector" 
          range="{{bloodTypeOptions}}"
          value="{{bloodTypeIndex}}" 
          bindchange="onBloodTypeChange"
        >
          <t-cell 
            title="血型" 
            arrow 
            note="{{bloodType || '请选择'}}" 
          />
        </picker>
      </t-cell-group>
      
      <!-- 身体指标部分 -->
      <t-cell-group title="出生时身体指标" style="margin-top: 20rpx;">
        <t-cell title="出生体重(kg)">
          <input 
            slot="note"
            class="baby-input" 
            placeholder="如：3.2" 
            value="{{birthWeight}}" 
            bindinput="onBirthWeightInput"
            type="digit"
            style="text-align: right;"
          />
        </t-cell>
        
        <t-cell title="出生身高(cm)">
          <input 
            slot="note"
            class="baby-input" 
            placeholder="如：50" 
            value="{{birthHeight}}" 
            bindinput="onBirthHeightInput"
            type="digit"
            style="text-align: right;"
          />
        </t-cell>
      </t-cell-group>
      
      <!-- 当前身体指标部分（可选） -->
      <t-cell-group title="当前身体指标（可选）" style="margin-top: 20rpx;">
        <t-cell title="当前体重(kg)">
          <input 
            slot="note"
            class="baby-input" 
            placeholder="如：8.5" 
            value="{{currentWeight}}" 
            bindinput="onCurrentWeightInput"
            type="digit"
            style="text-align: right;"
          />
        </t-cell>
        
        <t-cell title="当前身高(cm)">
          <input 
            slot="note"
            class="baby-input" 
            placeholder="如：72" 
            value="{{currentHeight}}" 
            bindinput="onCurrentHeightInput"
            type="digit"
            style="text-align: right;"
          />
        </t-cell>
      </t-cell-group>
      
      <!-- 按钮操作区 -->
      <view class="form-actions">
        <t-button theme="primary" block size="large" bind:tap="saveBaby" loading="{{isSaving}}">
          保存宝宝信息
        </t-button>
        <t-button wx:if="{{babies.length > 0}}" theme="light" block size="large" bind:tap="loadBabyData" style="margin-top: 20rpx;">
          取消
        </t-button>
      </view>
    </view>
  </view>
  
  <!-- ============================================================ -->
  <!-- 2. 宝宝信息展示界面 (保持不变) -->
  <!-- ============================================================ -->
  <view wx:else class="info-container">
    <view class="baby-header">
      <view class="baby-info">
        <view class="baby-avatar">👶</view>
        <view class="baby-details">
          <view class="baby-name-row">
            <text class="baby-name">{{currentBaby.name || '宝宝'}}</text>
            <view class="baby-selector" wx:if="{{babies.length > 1}}" bind:tap="showBabySelector">
              <text class="selector-text">切换</text>
              <text class="selector-arrow">▼</text>
            </view>
          </view>
          <text class="baby-age">{{currentBaby.ageStr || '0岁'}}</text>
          <text class="baby-count" wx:if="{{babies.length > 1}}">共{{babies.length}}个宝宝</text>
        </view>
      </view>
      
      <view class="baby-actions">
        <view class="action-btn" bind:tap="showAddForm">
          <text>➕</text>
        </view>
        <view class="action-btn" bind:tap="editCurrentBaby">
          <text>✏️</text>
        </view>
      </view>
    </view>
    
    <view class="baby-selector-modal" wx:if="{{showBabySelector}}" bind:tap="hideBabySelector">
      <view class="selector-content" catch:tap="">
        <view class="selector-title">选择宝宝</view>
        <view class="selector-list">
          <view 
            wx:for="{{babies}}" 
            wx:key="id" 
            class="selector-item {{index === currentBabyIndex ? 'active' : ''}}"
            bind:tap="selectBaby"
            data-index="{{index}}"
          >
            <view class="selector-avatar">👶</view>
            <view class="selector-info">
              <text class="selector-name">{{item.name}}</text>
              <text class="selector-age">{{item.ageStr}}</text>
            </view>
            <view class="selector-check" wx:if="{{index === currentBabyIndex}}">✓</view>
          </view>
        </view>
        <view class="selector-actions">
          <t-button bind:tap="goToAddBaby" block>添加新宝宝</t-button>
        </view>
      </view>
    </view>

    <view class="baby-info-card">
      <t-cell-group title="宝宝信息" theme="card">
        <t-cell title="姓名" note="{{currentBaby.name || '-'}}" />
        <t-cell title="性别" note="{{currentBaby.genderStr || '-'}}" />
        <t-cell title="出生日期" note="{{currentBaby.birthDate || '-'}}" />
        <t-cell title="年龄" note="{{currentBaby.ageStr || '-'}}" />
        <t-cell title="血型" note="{{currentBaby.bloodType || '-'}}型" />
      </t-cell-group>
      
      <t-cell-group title="出生时身体指标" theme="card" style="margin-top: 24rpx;">
        <t-cell title="出生体重" note="{{currentBaby.displayWeight}}" />
        <t-cell title="出生身高" note="{{currentBaby.displayHeight}}" />
      </t-cell-group>
      
      <t-cell-group title="当前身体指标" theme="card" style="margin-top: 24rpx;">
        <t-cell title="当前体重" note="{{currentBaby.currentWeight || '-'}}" />
        <t-cell title="当前身高" note="{{currentBaby.currentHeight || '-'}}" />
      </t-cell-group>
    </view>
  </view>
</view>