/* 响应式适配 */
@media (max-width: 375px) {
  .form-container {
    padding: 24rpx;
  }
  
  .avatar-container {
    width: 140rpx;
    height: 140rpx;
  }
  
  .avatar-icon {
    font-size: 70rpx;
  }
}