/* 编辑宝宝页面样式 */
.edit-baby-page {
  min-height: 100vh;
  background-color: #f8f8f8;
  padding: 20rpx;
}

.form-container {
  background-color: #ffffff;
  border-radius: 16rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}

/* 头像部分 */
.avatar-section {
  display: flex;
  justify-content: center;
  margin-bottom: 40rpx;
}

.avatar-container {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background-color: #f0f0f0;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 4rpx solid #FFB6C1;
}

.avatar-image {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}

.avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.avatar-icon {
  font-size: 80rpx;
}

.avatar-edit-hint {
  position: absolute;
  bottom: -40rpx;
  left: 50%;
  transform: translateX(-50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 8rpx 16rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  white-space: nowrap;
}

/* 日期显示 */
.date-display {
  color: #333;
  font-size: 32rpx;
}

/* 操作按钮 */
.action-buttons {
  margin-top: 60rpx;
}

.action-buttons .t-button {
  margin-bottom: 24rpx;
}

.danger-actions {
  margin: 24rpx 0;
}

/* 表单分组标题 */
.t-cell-group__title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  margin-bottom: 16rpx;
}

/* 输入框样式 */
.t-input {
  margin-bottom: 16rpx;
}

/* 单选按钮组 */
.t-radio-group {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.t-radio {
  margin-right: 32rpx;
}

/* 性别按钮样式 */
.gender-button {
  padding: 12rpx 36rpx;
  border-radius: 8rpx;
  margin-right: 24rpx;
  font-size: 28rpx;
  transition: all 0.2s;
  border: 1px solid #dcdcdc;
  color: #666;
  background: #f5f5f5;
}

.gender-button:last-child {
  margin-right: 0;
}

.gender-button-active {
  border: 1px solid #0052d9;
  color: #0052d9;
  background: #ecf2fe;
}

.gender-button[data-value="female"].gender-button-active {
  border: 1px solid #ff0080;
  color: #ff0080;
  background: #fff0f6;
}

