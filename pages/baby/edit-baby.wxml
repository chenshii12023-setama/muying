<view class="edit-baby-page">
  <view class="form-container">
    <!-- 头像部分 -->
    <view class="avatar-section">
      <view class="avatar-container" bind:tap="chooseAvatar">
        <image 
          wx:if="{{babyData.avatar}}" 
          src="{{babyData.avatar}}" 
          class="avatar-image"
          mode="aspectFill"
        />
        <view wx:else class="avatar-placeholder">
          <text class="avatar-icon">{{babyData.gender === 'male' ? '👦' : '👧'}}</text>
        </view>
        <view class="avatar-edit-hint">
          <text>点击编辑头像</text>
        </view>
      </view>
    </view>

    <!-- 基本信息表单 -->
    <t-cell-group title="基本信息">
      <!-- 姓名 -->
      <t-cell title="姓名" required>
        <input 
          slot="note"
          class="baby-input" 
          placeholder="请输入宝宝姓名" 
          value="{{babyData.name}}" 
          bindinput="onInputChange"
          data-field="name"
          style="text-align: right;"
        />
      </t-cell>
      
      <!-- 性别 (使用原生按钮，与添加宝宝页面一致) -->
      <view class="custom-cell" style="background: #fff; padding: 24rpx 32rpx; display: flex; align-items: center; justify-content: space-between; border-bottom: 1rpx solid #f0f0f0;">
        <view style="font-size: 32rpx; color: rgba(0, 0, 0, 0.9);">
          性别 <text style="color: #e34d59">*</text>
        </view>
        
        <view style="display: flex;">
          <!-- 男宝按钮 -->
          <view 
            bindtap="onGenderSelect" 
            data-value="male"
            class="gender-button {{babyData.gender === 'male' ? 'gender-button-active' : ''}}"
          >
            男宝 👦
          </view>
          
          <!-- 女宝按钮 -->
          <view 
            bindtap="onGenderSelect" 
            data-value="female"
            class="gender-button {{babyData.gender === 'female' ? 'gender-button-active' : ''}}"
          >
            女宝 👧
          </view>
        </view>
      </view>
      
      <!-- 出生日期 (Picker 包裹 Cell) -->
      <picker 
        mode="date" 
        value="{{babyData.birthDate}}" 
        bindchange="onDateChange"
        start="2010-01-01"
        end="2030-12-31"
      >
        <t-cell 
          title="出生日期" 
          required 
          arrow 
          note="{{babyData.birthDate || '请选择'}}" 
        />
      </picker>
      
      <!-- 血型 (Picker 包裹 Cell) -->
      <picker 
        mode="selector" 
        range="{{bloodTypeOptions}}"
        value="{{bloodTypeIndex}}" 
        bindchange="onBloodTypeChange"
      >
        <t-cell 
          title="血型" 
          arrow 
          note="{{babyData.bloodType || '请选择'}}" 
        />
      </picker>
    </t-cell-group>

    <!-- 出生时身体指标 -->
    <t-cell-group title="出生时身体指标">
      <t-cell title="出生体重 (kg)">
        <input 
          slot="note"
          class="baby-input" 
          placeholder="如：3.2" 
          value="{{babyData.birthWeight}}" 
          bindinput="onInputChange"
          data-field="birthWeight"
          type="digit"
          style="text-align: right;"
        />
      </t-cell>
      
      <t-cell title="出生身高 (cm)">
        <input 
          slot="note"
          class="baby-input" 
          placeholder="如：50" 
          value="{{babyData.birthHeight}}" 
          bindinput="onInputChange"
          data-field="birthHeight"
          type="digit"
          style="text-align: right;"
        />
      </t-cell>
    </t-cell-group>

    <!-- 当前身体指标 -->
    <t-cell-group title="当前身体指标">
      <t-cell title="当前体重 (kg)">
        <input 
          slot="note"
          class="baby-input" 
          placeholder="如：8.5" 
          value="{{babyData.currentWeight}}" 
          bindinput="onInputChange"
          data-field="currentWeight"
          type="digit"
          style="text-align: right;"
        />
      </t-cell>
      
      <t-cell title="当前身高 (cm)">
        <input 
          slot="note"
          class="baby-input" 
          placeholder="如：72" 
          value="{{babyData.currentHeight}}" 
          bindinput="onInputChange"
          data-field="currentHeight"
          type="digit"
          style="text-align: right;"
        />
      </t-cell>
    </t-cell-group>

    <!-- 操作按钮 -->
    <view class="action-buttons">
      <t-button 
        theme="primary" 
        size="large" 
        bind:tap="saveBaby"
        loading="{{isSaving}}"
        block
      >
        保存修改
      </t-button>
      
      <view class="danger-actions">
        <t-button 
          theme="light" 
          variant="text"
          size="large" 
          bind:tap="deleteBaby"
          loading="{{isDeleting}}"
          block
        >
          <text style="color: #ff4757;">删除宝宝</text>
        </t-button>
      </view>
      
      <t-button 
        theme="light" 
        variant="text"
        size="large" 
        bind:tap="cancel"
        block
      >
        取消
      </t-button>
    </view>
  </view>
</view>